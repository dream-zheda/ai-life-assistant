{
  "name": "ai-life-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/worker/tsconfig.json --noEmit",
    "typecheck:packages": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "node scripts/dev-db.mjs node node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "worker:once": "node scripts/dev-db.mjs node node_modules/tsx/dist/cli.mjs apps/worker/src/index.ts --once",
    "db:validate": "prisma validate --schema packages/db/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:up": "node scripts/dev-db.mjs start",
    "db:migrate": "node scripts/dev-db.mjs prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:reset": "node scripts/dev-db.mjs prisma migrate reset --force --skip-seed --schema packages/db/prisma/schema.prisma",
    "db:verify": "node scripts/dev-db.mjs sql scripts/verify-constraints.sql",
    "db:seed": "node scripts/dev-db.mjs sql scripts/seed.sql",
    "db:drop": "node scripts/dev-db.mjs drop",
    "db:rehearse": "node scripts/rehearse-migrate.mjs",
    "config:check": "node scripts/check-compose.mjs",
    "preflight": "node scripts/preflight.mjs",
    "invite:create": "node scripts/dev-db.mjs node node_modules/tsx/dist/cli.mjs scripts/create-invite.ts",
    "verify:invites": "node scripts/dev-db.mjs node node_modules/tsx/dist/cli.mjs scripts/verify-invites.ts",
    "e2e": "node scripts/dev-db.mjs node node_modules/tsx/dist/cli.mjs scripts/e2e-walkthrough.ts",
    "web:dev": "pnpm --filter @life/web dev",
    "web:build": "pnpm --filter @life/web build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  }
}
