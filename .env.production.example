# 生产环境配置模板：复制为 .env 后填写真实值。
#
# ⚠️ 与本地开发的区别：
# - 数据库主机是 db（docker 内网），不是 127.0.0.1
# - 必须使用真实的 BETTER_AUTH_SECRET 与 APP_BASE_URL
# - 本地开发用的 embedded-postgres（端口 55432）在生产不存在

# --- 数据库 ---
POSTGRES_USER=life
POSTGRES_PASSWORD=请替换为强随机密码
POSTGRES_DB=life_assistant
# 只绑定宿主机本地，不暴露到公网；不需要外部访问时整行删掉 ports
DB_PUBLISH_PORT=5432

# --- 应用 ---
# 必须是用户真正访问的地址（含协议与端口），否则 Better Auth 的 cookie 域对不上
APP_BASE_URL=https://your-domain.example
# openssl rand -hex 32
BETTER_AUTH_SECRET=请替换为随机 32 字节十六进制
WEB_PORT=3100
TZ=Asia/Shanghai

# --- worker ---
WORKER_TICK_MS=15000

# --- 模型 ---
# 留空且用户没有个人模型配置时，不允许生成计划
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- QQ（可选；同一机器人服务多个用户）---
# 容器里不能用 127.0.0.1 访问宿主机 NapCat，请填写容器可达的地址
ONEBOT_ENDPOINT=
ONEBOT_TOKEN=
ONEBOT_SECRET=
ONEBOT_SELF_ID=
ONEBOT_AUTO_ACCEPT_FRIENDS=false
WORKER_HTTP_PORT=8789
