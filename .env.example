# ============================================================
# 复制为 .env 后填写。切勿提交含真实密钥的 .env。
# ============================================================

# --- 数据库 ---
# 生产：由 compose.yaml 提供的 PostgreSQL
DATABASE_URL="postgresql://life:life@127.0.0.1:5432/life_assistant?schema=public"

# --- 应用 ---
APP_BASE_URL="http://127.0.0.1:3000"
# 认证库主密钥：openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me"

# --- 模型服务商 ---
# 只填本机已申请的；未配置的服务商在界面显示为「未配置」，不得宣称已验证。
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_BASE_URL=""

# --- 微信通道（P0 待定，填了才会启用）---
WECHAT_CHANNEL=""           # wecom | official-account | undefined
WECHAT_CORP_ID=""
WECHAT_AGENT_ID=""
WECHAT_SECRET=""
WECHAT_CALLBACK_TOKEN=""
WECHAT_CALLBACK_AES_KEY=""

# --- QQ：管理员维护一个机器人，所有用户通过好友私聊绑定 ---
ONEBOT_ENDPOINT=""
ONEBOT_TOKEN=""
# NapCat HTTP 客户端的 token（用于 x-signature），不是 HTTP 服务器 token
ONEBOT_SECRET=""
ONEBOT_SELF_ID=""
ONEBOT_AUTO_ACCEPT_FRIENDS=false
WORKER_HTTP_PORT=8789
WORKER_HTTP_HOST=127.0.0.1
